{
  "name": "@nodobito/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --import tsx --watch src/index.ts",
    "start": "node --env-file-if-exists=../../.env --import tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "dev:cloudflare": "wrangler dev --local --ip 0.0.0.0 --config wrangler.jsonc",
    "deploy:cloudflare": "wrangler deploy --env production --config wrangler.jsonc",
    "typecheck:cloudflare": "tsc --noEmit -p tsconfig.cloudflare.json",
    "d1:migrate:local": "wrangler d1 migrations apply nodobito-db --local --config wrangler.jsonc",
    "d1:migrate:remote": "wrangler d1 migrations apply DB --remote --env production --config wrangler.jsonc",
    "backup": "node --env-file-if-exists=../../.env scripts/backup.mjs",
    "backup:cloudflare": "node scripts/cloudflare-backup.mjs backup",
    "restore:cloudflare": "node scripts/cloudflare-backup.mjs restore",
    "test:cloudflare": "node --import tsx --test tests/cloudflare.test.ts",
    "test:mobile-integration": "node scripts/test-mobile-integration.mjs",
    "seed:daily:local": "node scripts/seed-daily-local.mjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "fast-png": "^8.0.0",
    "hono": "^4.13.19",
    "jpeg-js": "^0.4.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261117.1",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.163.0"
  }
}

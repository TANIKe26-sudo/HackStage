{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nodobito-api",
  "main": "src/cloudflare.ts",
  "compatibility_date": "2026-11-17",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nodobito-db",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "CAPTURES", "bucket_name": "nodobito-private-captures" }
  ],
  "triggers": { "crons": ["*/5 * * * *"] },
  "env": {
    "production": {
      "name": "nodobito-api",
      "account_id": "94525e870e53136c86279f0a75bc70b6",
      "workers_dev": true,
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "hackstage_nodo",
          "database_id": "843bb329-6a8b-4273-81d8-e81d9274dc1e",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        { "binding": "CAPTURES", "bucket_name": "nodobito-private-captures" }
      ]
    }
  }
}

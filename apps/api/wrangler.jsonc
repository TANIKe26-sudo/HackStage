{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nodobito-api",
  "main": "src/cloudflare.ts",
  "compatibility_date": "2026-11-17",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "vars": {
    "APP_ENV": "development",
    "AUTH_PROVIDER": "appwrite",
    "APPWRITE_ENDPOINT": "https://sgp.cloud.appwrite.io/v1",
    "APPWRITE_PROJECT_ID": "6afe98140007431a2096"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nodobito-db",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "env": {
    "production": {
      "name": "nodobito-api",
      "account_id": "94525e870e53136c86279f0a75bc70b6",
      "workers_dev": true,
      "vars": {
        "APP_ENV": "production",
        "AUTH_PROVIDER": "appwrite",
        "APPWRITE_ENDPOINT": "https://sgp.cloud.appwrite.io/v1",
        "APPWRITE_PROJECT_ID": "6afe98140007431a2096"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "hackstage_nodo",
          "database_id": "843bb329-6a8b-4273-81d8-e81d9274dc1e",
          "migrations_dir": "migrations"
        }
      ],
      "ai": {
        "binding": "AI"
      }
    }
  }
}

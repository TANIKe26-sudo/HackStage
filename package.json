{
  "name": "nodobito-matching-app",
  "private": true,
  "workspaces": ["apps/*"],
  "scripts": {
    "dev": "concurrently -k -n api,mobile -c blue,magenta \"npm run dev:api\" \"npm run dev:mobile\"",
    "dev:api": "npm run dev --workspace @nodobito/api",
    "dev:mobile": "npm run start --workspace mobile"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
